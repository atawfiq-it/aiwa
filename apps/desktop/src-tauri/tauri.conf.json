{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "AIWA",
  "version": "0.1.0",
  "identifier": "com.aiwa.workstation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIWA - Local Multimodal AI Workstation",
        "width": 1360,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "sidecar/**/*"
    ],
    "externalBin": [
      "binaries/aiwa-backend"
    ],
    "category": "Development",
    "shortDescription": "Local Multimodal AI Workstation",
    "longDescription": "Developer-oriented local multimodal AI workstation for language, vision, audio, and diffusion models."
  }
}
