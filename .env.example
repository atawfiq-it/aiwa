# ==========================================
# AIWA Phase 9: Universal Engine Configuration
# ==========================================

# Environment Mode ("development" or "production")
ENVIRONMENT=development

# Server Networking
API_HOST=127.0.0.1
API_PORT=8000

# Hardware Acceleration Profile ("auto", "cuda", "rocm", "metal", "vulkan", "cpu")
AIWA_HARDWARE_ACCELERATION=auto
MAX_GPU_USAGE_PERCENT=80.0
VRAM_SAFETY_MARGIN_MB=1024

# Model Directories (Comma, colon, or newline separated absolute paths)
DIFFUSION_MODEL_DIRECTORIES="/users/your_name/aiwa/data/diff_models_dir"
LLM_MODEL_DIRECTORIES="/users/your_name/aiwa/data/llm_models_dir"

# Runtimes & Daemons
LLAMA_SERVER_PORT=8080
COMFYUI_PORT=8188


# Default/Last Model names
DEFAULT_LLM_MODEL: str = "Qwen3-VL-8B-Instruct"
DEFAULT_DIFFUSION_MODEL: str = "dreamshaper 8"
