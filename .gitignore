# =========================================================
# AIWA Workstation Security & Packaging Exclusion Rules
# =========================================================

# 1. Tauri Desktop Shell Builds & Staged Packaging Sidecars
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/sidecar/
apps/desktop/src-tauri/binaries/
apps/desktop/dist/
apps/desktop/node_modules/
*.AppImage
*.deb
*.rpm
*.msi
*.exe

# 2. PyInstaller Freezing & Python Distribution Artifacts
backend/build/
backend/dist/
backend/*.spec
build/
dist/
*.spec

# 3. Python Virtual Environments, Bytecode & Caches
.venv/
backend/.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# 4. Ephemeral Security Tokens & Environment Files
data/.aiwa_session_token*
.aiwa_session_token*
data/.aiwa_session_token
.aiwa_session_token
.env
.env.*
*.local.env
*.pem
*.key

# 5. SQLite Databases & WAL Journal Files
data/database/*.db
data/database/*.db-journal
data/database/*.db-wal
data/database/*.db-shm
*.db
*.sqlite
*.sqlite3

# 6. User Uploads (Documents, PDFs, Images)
data/uploads/*
!data/uploads/.gitkeep

# 7. Generated Media (ComfyUI / Diffusers Images, Kokoro Audio)
data/generated/*
!data/generated/.gitkeep

# 8. Local Vector Store, Logs & Caches
data/vector_store/*
!data/vector_store/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/logs/*
!data/logs/.gitkeep

# 9. Large Model Weights & Checkpoints (All Drives)
data/models/**/*.gguf
data/models/**/*.safetensors
data/models/**/*.ckpt
data/models/**/*.bin
data/models/**/*.onnx
data/models/**/*.pt
*.gguf
*.safetensors
*.ckpt
*.onnx

# 10. Embedded External Services & Subprocesses
services/*
services/llama-cpp/llama-server
services/llama-cpp/src/
services/llama-cpp/*.zip
services/comfyui/app/
services/comfyui/.venv/
services/comfyui/models/checkpoints/*
services/diffusion-cpp/
services/diffusion-cpp/*
services/diffusion-cpp/sd/
services/diffusion-cpp/src/

# 11. OS & IDE Metadata
.DS_Store
.idea/
.vscode/
*.swp
*.swo

#12 Other files
*.lock
apps/desktop/src-tauri/gen*
